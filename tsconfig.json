{
  "extends": "ts-node/node16/tsconfig.json",

  "ts-node": {
    "files": true,
  },
  "compilerOptions": {
    "target": "ES2024",
    "module": "commonjs",
    "lib": ["dom"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
  },
  "include": ["src/**/*"],
}