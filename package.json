{
  "name": "charlottes-notes",
  "version": "2.0.0",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "restartable": "rs",
    "ignore": [
      ".git",
      "node_modules/**/node_modules"
    ],
    "watch": [
      "./notes",
      "./public",
      "./src",
      "./views"
    ],
    "ext": "ts,js,json,md,pug,css",
    "delay": 2500
  },
  "keywords": [],
  "author": "challeau",
  "license": "ISC",
  "description": "All my documentation in one place",
  "dependencies": {
    "express": "5.1.0",
    "jquery": "3.7.1",
    "jsdom": "26.1.0",
    "pug": "3.0.3",
    "marked": "15.0.11",
    "sanitize-html": "2.16.0"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/jquery": "3.5.32",
    "@types/marked": "5.0.2",
    "@types/node": "22.15.17",
    "@types/sanitize-html": "2.16.0",
    "nodemon": "3.1.10",
    "ts-node": "10.9.2"
  },
  "engines": {
    "node": ">=18.x"
  }
}
