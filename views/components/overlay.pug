// Navbar menu
mixin menu(isHome)
  div(id="menu")
    if !isHome
      span(id="menu-toc", class="menu-tab") TOC
      span(id="menu-separator") |
    span(id="menu-topics", class="active menu-tab") TOPICS

// Navigation folder == a subject
mixin navFolder(name, links)
  ul.collapsible
    li.folder-title= name
    li.folder
      div.list-divider
      ul
        each page in links
          li.subject
            a(href=page.endpoint, class="tooltip")= page.title
            if page.description
              span.tooltip-text= page.description

// Navbar topics list
mixin topicsList(topics)
  ul(id="topics")
    each files, folderName in topics
      li.folder-container
        +navFolder(folderName, files)

// OVERLAY == navBar + logo + utility buttons
mixin overlay(topics, isHome)
  div(id="overlay")
    div(id="nav-bar-container")
      div(id="nav-fold-btn" class="nav-btn")
        span.material-symbols-outlined= "navigate_next"
      div(id="nav-bar")
        +menu(isHome)
        +topicsList(topics)

    div(id="btns-container")
      div(id="to-top-btn" class="nav-btn")
        span.material-symbols-outlined= "arrow_upward"
      div(id="theme-btn" class="nav-btn")
        span.material-symbols-outlined= "dark_mode"

  // import functionality scripts
  script(src="http://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js" type="text/javascript")
  script
    include ../scripts/overlay.js

  // get theme setting from local storage
  script.
    document.body.classList = localStorage.getItem("theme") || "light";