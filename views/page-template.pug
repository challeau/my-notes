include ./components/head.pug
include ./components/overlay.pug
include ./components/peek-oe.pug

doctype html
html
  head
    +head(title)

  body
    +overlay(navbarData, false)

    a(href="/" style="display: block;")
      img(src="assets/pekoe/pekoe.svg#pek-logo" shape-rendering="crispEdges" alt="Pekoe logo" id="pekoe-logo")
    div.page
      | !{content}
    +peek-oe

    // import TOC script here cause we need the full page to be loaded before constructing it
    script(src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js" type="text/javascript")
    script
      include ./scripts/toc.js
