include ./components/overlay.pug
include ./components/head.pug

doctype html
html
  head
    +head(title)
    script.
      localStorage.setItem("current-page", "");

  body
    +overlay(navbarData, false)

    div.page
      h1= title

      div.index
        ul.index-list 
          each page in navbarData[title]
            li
              a(href=page.endpoint)= page.title
