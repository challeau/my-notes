include ./components/overlay.pug
include ./components/head.pug
include ./components/peek-oe.pug

doctype html
html
  head
    +head(title)

  body
    +overlay(navbarData, true)

    a(href="/")
      img(src="assets/pekoe/pekoe.svg#pek-logo" shape-rendering="crispEdges" alt="Pekoe logo" id="pekoe-logo")
    div.page
      h1 Charlotte's Notes
      p This is a collection of my Web Development notes so I can access them anywhere with an internet connection.
      p These notes contain my work, and text copied from software documentation.

      div.index
        each files, folder in navbarData
          if (folder !== 'root')
            span.index-list-title=folder
            ul.index-list
              each page in files
                li
                  a(href=page.endpoint)= page.title
          else
            ul.index-list
              each page in files
                li
                  a(href=page.endpoint)= page.title
    +peek-oe
